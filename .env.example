# ---------------------------------------------------------------
# Copia este archivo a .env y ajusta los valores:  cp .env.example .env
# Todas las variables son OBLIGATORIAS: la app no arranca si falta alguna.
# docker-compose.yml lee este mismo .env (una sola fuente de verdad).
# ---------------------------------------------------------------

# Entorno: development | production | test
NODE_ENV=development
# Puerto HTTP de la API
PORT=3000

# PostgreSQL (los mismos valores usa Docker Compose para crear la base)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ticketing
DB_PASSWORD=change-me-local-only
DB_NAME=ticketing
# Base usada por pnpm test:e2e (se crea automáticamente si no existe)
DB_NAME_TEST=ticketing_test

# Secreto para el HMAC de los códigos de entrada (mínimo 32 caracteres).
# En un entorno real, genera uno propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_CODE_SECRET=change-me-local-only-0123456789abcdef

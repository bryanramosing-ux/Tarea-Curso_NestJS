# ---------------------------------------------------------------
# Copia este archivo a .env y ajusta los valores:  cp .env.example .env
# Todas las variables son OBLIGATORIAS: la app no arranca si falta alguna.
# docker-compose.yml lee este mismo .env (una sola fuente de verdad).
#
# Los valores que contienen "change-me" son PÚBLICOS (están en el repositorio):
# sirven para desarrollo local, pero con NODE_ENV=production la app se niega
# a arrancar si alguno sigue igual. Genera secretos reales con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------

# Entorno: development | production | test
NODE_ENV=development
# Puerto HTTP de la API
PORT=3000

# PostgreSQL (los mismos valores usa Docker Compose para crear la base)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ticketing
DB_PASSWORD=change-me-local-only
DB_NAME=ticketing
# Base usada por pnpm test:e2e (se crea automáticamente si no existe)
DB_NAME_TEST=ticketing_test

# Secreto para el HMAC de los códigos de entrada (mínimo 32 caracteres).
TICKET_CODE_SECRET=change-me-local-only-0123456789abcdef

# Claves de API del personal (mínimo 32 caracteres, distintas entre sí).
# Se envían en la cabecera:  Authorization: Bearer <clave>
#  - ORGANIZER: programar/cancelar eventos, consultar entradas, conciliar ventas
#  - GATE: personal de puerta (check-in y consulta de entradas)
ORGANIZER_API_KEY=change-me-organizer-key-0123456789abcdef
GATE_API_KEY=change-me-gate-key-0123456789abcdef0123

# Límite de peticiones por IP (respuesta 429 al superarlo)
THROTTLE_TTL_SECONDS=60
# Cualquier ruta
THROTTLE_LIMIT=120
# Rutas sensibles: compra de entradas y check-in (debe ser <= THROTTLE_LIMIT)
THROTTLE_SENSITIVE_LIMIT=20
# true solo si la API está detrás de un proxy inverso de confianza (usa X-Forwarded-For)
TRUST_PROXY=false

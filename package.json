{
  "name": "ticketing-hexagonal-nestjs",
  "version": "1.0.0",
  "description": "Venta de entradas para eventos: NestJS + Arquitectura Hexagonal + DDD táctico + CQRS",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/typeorm.data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/typeorm.data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/typeorm.data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/config/typeorm.data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/config/typeorm.data-source.js",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "16.6.1",
    "helmet": "8.3.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test/architecture"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/**/*.module.ts",
      "!src/database/migrations/**"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
